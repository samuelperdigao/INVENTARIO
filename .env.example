# URL do FastAPI usado apenas para gerar uma análise nova. O lançamento local não depende dela.
# In production, both public URLs must be HTTPS and share the frontend's registrable domain.
NEXT_PUBLIC_ANALYSIS_API_BASE_URL=http://localhost:8000
# URL pública do FastAPI para sincronização; se ausente, usa a URL de análise.
NEXT_PUBLIC_SYNC_API_BASE_URL=http://localhost:8000
INVENTORY_ENV=development
# Desenvolvimento local: SQLite. Produção: PostgreSQL com o driver psycopg.
INVENTORY_DATABASE_URL=sqlite:///./backend/inventario.db
# Production: PostgreSQL URL with provider-required SSL. Never commit the real value.
# Format example: postgresql+psycopg://usuario:senha@host:5432/inventario?sslmode=require
INVENTORY_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres
INVENTORY_ACCESS_TOKEN_MINUTES=15
INVENTORY_REFRESH_SESSION_DAYS=14
INVENTORY_CORS_ORIGINS=https://inventario.exemplo.com
# Exportações e snapshots de relatório não usam variáveis adicionais; dependências Python ficam em backend/requirements.txt.
